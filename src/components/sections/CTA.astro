---
// Call to Action section
---

<section id="contact" class="section-padding bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-primary-600 to-secondary-700 rounded-2xl shadow-2xl p-8 md:p-12 lg:p-16 text-white text-center reveal">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-6">
          Ready to Transform Your Business?
        </h2>
        <p class="text-lg md:text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
          Join hundreds of leading companies that trust us to drive their digital transformation and achieve exceptional results.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="#" class="btn-primary bg-white text-primary-600 hover:bg-primary-50 min-w-[200px] text-center">
            Schedule a Demo
          </a>
          <a href="#" class="btn-secondary border-white text-white hover:bg-white/10 min-w-[200px] text-center">
            Contact Sales
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
