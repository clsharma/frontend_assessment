---
interface Props {
  title: string;
  description: string;
  image?: string;
  icon?: string;
}

const { title, description, image, icon } = Astro.props;
---

<div class="card group overflow-hidden">
  {image && (
    <div class="mb-4 -mx-6 -mt-6 overflow-hidden rounded-t-xl">
      <img 
        src={image} 
        alt={title}
        class="w-full h-48 object-cover group-hover:scale-110 transition-transform duration-500"
      />
    </div>
  )}
  {icon && !image && (
    <div class="mb-4">
      <div class="w-14 h-14 bg-gradient-primary rounded-lg flex items-center justify-center text-white text-2xl">
        {icon}
      </div>
    </div>
  )}
  <h3 class="text-xl md:text-2xl font-bold mb-3 text-gray-900 group-hover:text-primary-600 transition-colors">
    {title}
  </h3>
  <p class="text-gray-600 leading-relaxed">
    {description}
  </p>
</div>
