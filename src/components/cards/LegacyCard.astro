---
interface Props {
  year: string;
  title: string;
  description: string;
  image?: string;
}

const { year, title, description, image } = Astro.props;
---

<div class="card group flex flex-col md:flex-row gap-6">
  {image && (
    <div class="md:w-1/3 -mx-6 -mt-6 md:mx-0 md:mt-0 md:ml-0 overflow-hidden rounded-t-xl md:rounded-l-xl md:rounded-tr-none">
      <img 
        src={image} 
        alt={title}
        class="w-full h-48 md:h-full object-cover group-hover:scale-110 transition-transform duration-500"
      />
    </div>
  )}
  <div class="flex-1">
    <div class="text-primary-600 font-bold text-2xl mb-2">
      {year}
    </div>
    <h3 class="text-xl md:text-2xl font-bold mb-3 text-gray-900">
      {title}
    </h3>
    <p class="text-gray-600 leading-relaxed">
      {description}
    </p>
  </div>
</div>
