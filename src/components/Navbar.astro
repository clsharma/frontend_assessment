---
// Navbar component with responsive design
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#" class="text-2xl font-display font-bold text-primary-600 hover:text-primary-700 transition-colors">
        Company
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="#hero" class="text-gray-700 hover:text-primary-600 font-medium transition-colors">Home</a>
        <a href="#legacy" class="text-gray-700 hover:text-primary-600 font-medium transition-colors">Legacy</a>
        <a href="#innovation" class="text-gray-700 hover:text-primary-600 font-medium transition-colors">Innovation</a>
        <a href="#impact" class="text-gray-700 hover:text-primary-600 font-medium transition-colors">Impact</a>
        <a href="#contact" class="btn-primary">Contact Us</a>
      </div>
      
      <!-- Mobile Menu Toggle -->
      <button 
        id="mobile-menu-toggle"
        class="md:hidden text-gray-700 hover:text-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 rounded-lg p-2"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  
  const updateNavbar = () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-white/80', 'backdrop-blur-md', 'shadow-md');
    } else {
      navbar?.classList.remove('bg-white/80', 'backdrop-blur-md', 'shadow-md');
    }
  };
  
  window.addEventListener('scroll', updateNavbar);
  updateNavbar();
</script>
